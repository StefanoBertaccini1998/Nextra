# === Normalize line endings ===
# Force text files to use LF (Unix) in repo, CRLF only in Windows working dir

* text=auto eol=lf

# Mark some as binary to avoid line ending normalization
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.pdf binary
*.zip binary
*.gz binary
*.svg binary

# Keep scripts LF only (important for Docker/WSL)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md text eol=lf
*.dockerfile text eol=lf
*.env text eol=lf
